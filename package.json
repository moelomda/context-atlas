{
  "name": "context-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed temporal project memory for developers and coding agents",
  "author": "Context Atlas Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moelomda/context-atlas.git"
  },
  "homepage": "https://github.com/moelomda/context-atlas#readme",
  "bugs": {
    "url": "https://github.com/moelomda/context-atlas/issues"
  },
  "keywords": [
    "ai",
    "developer-tools",
    "documentation",
    "git",
    "knowledge-graph",
    "llm",
    "mcp",
    "project-memory",
    "software-architecture"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extensions": {
      "types": "./dist/extensions/index.d.ts",
      "import": "./dist/extensions/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "context-atlas": "./dist/cli.js",
    "context-atlas-mcp": "./dist/mcp/server.js"
  },
  "files": [
    "dist",
    "docs",
    "plugin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "mcp": "node dist/mcp/server.js",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-lines=85 --test-coverage-functions=85 --test-coverage-branches=55 --import tsx --test tests/**/*.test.ts",
    "check": "npm run build && npm run typecheck:tests && npm test",
    "prepack": "npm run build"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.12.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "license": "MIT"
}
